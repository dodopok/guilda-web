{
  "name": "guilda-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "worker": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-dev-db.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "estevao:mock": "tsx scripts/estevao-mock.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "docs:openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  }
}
