# Copie para .env e ajuste. Nunca coloque segredos reais no repositório.

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://guilda:guilda@localhost:5432/guilda
TEST_DATABASE_URL=postgres://guilda:guilda@localhost:5432/guilda_test

# Endereço público usado nos links enviados (convites, lembretes, roteiros).
APP_BASE_URL=http://localhost:3000

# Cookie de sessão só por HTTPS. Use true em qualquer ambiente acessível pela rede.
SESSION_COOKIE_SECURE=false
# Duração da sessão em dias.
SESSION_TTL_DAYS=30

# Chave de 32 bytes em base64 para cifrar tokens do WhatsApp guardados no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Custo do scrypt (log2 de N). 17 é o mínimo recomendado pela OWASP; os testes usam menos.
PASSWORD_SCRYPT_LOG2N=17

# WhatsApp Cloud API (oficial). Mesmo com canal configurado na igreja, nenhum envio real
# acontece sem esta chave global explicitamente em true.
WHATSAPP_ALLOW_REAL_SEND=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v25.0

# Estêvão API (calendário e lecionário do LOC). Sem chave, o roteiro usa preenchimento manual.
ESTEVAO_API_URL=
ESTEVAO_API_KEY=
ESTEVAO_PRAYER_BOOK=loc_2027
ESTEVAO_READING_TYPE=complementary
ESTEVAO_TIMEOUT_MS=8000

# Trabalhador de tarefas agendadas
WORKER_INTERVAL_SECONDS=30
# Atraso máximo aceito para disparar um lembrete perdido (trabalhador parado, por exemplo).
REMINDER_CATCHUP_HOURS=6
# Somente desenvolvimento: roda o ciclo do trabalhador dentro do "pnpm dev".
WORKER_INLINE=false
